+    # ── 零点 ────────────────────────────────────────────────────────────
+
+    def set_zero(self, poll_max: int = 200, poll_interval: float = 0.05) -> None:
+        # RobStride drives do not reliably return feedback while disabled.  The
+        # legacy Damiao path deliberately disabled first, but that leaves an RS
+        # calibration loop polling silent motors and makes its zero requests
+        # appear to time out.  Enabling here sends no position target; it only
+        # makes the drives acknowledge and lets us verify their live state before
+        # recording the current pose as zero.
+        has_robstride = any(jc.vendor == "robstride" for jc in self._all_joints)
+        if has_robstride:
+            self.enable_all()
+        else:
+            self.disable_all()
+        time.sleep(0.3)
